filters:
  and:
    - file.inFolder("Academics/Sources/Books")
views:
  - type: cards
    name: Card View
    filters:
      and:
        - file.inFolder("Academics/Sources/Books")
    order:
      - Title
      - Author(s)
      - Year
      - Topic(s)
      - Image
    image: note.Image
    imageAspectRatio: 1
    cardSize: 200
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Academics/Sources/Books")
    order:
      - file.name
      - Author(s)
      - Topic(s)
      - Year
      - URL
    sort:
      - property: URL
        direction: DESC
      - property: Topic(s)
        direction: ASC
    columnSize:
      file.name: 166
      note.Author(s): 183
      note.Topic(s): 159
      note.Year: 167
      note.URL: 215
