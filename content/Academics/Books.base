filters:
  and:
    - file.inFolder("Academics/Sources/Books")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Academics/Sources/Books")
        - file.name != "index"
    order:
      - file.name
      - Author(s)
      - tags
    sort:
      - property: tags
        direction: DESC
      - property: URL
        direction: DESC
    columnSize:
      file.name: 200
      note.Author(s): 200
      note.Topic(s): 200
      note.Year: 200
      note.URL: 200
    rowHeight: medium
  - type: table
    name: Author
    filters:
      and:
        - file.hasLink("Academics/Sources/Authors/David Bawden")
  - type: cards
    name: Card View
    filters:
      and:
        - file.inFolder("Academics/Sources/Books")
    order:
      - Title
      - Author(s)
      - Year
      - Topic(s)
      - Image
    image: note.Image
    imageAspectRatio: 1
    cardSize: 200
