filters:
  and:
    - file.name != "index"
properties:
  note.Author(s):
    displayName: author(s)
views:
  - type: table
    name: All
    filters:
      or:
        - file.inFolder("Academics/Sources/Books")
        - file.inFolder("Academics/Sources/Papers")
    order:
      - file.name
      - Author(s)
      - Type
      - tags
    rowHeight: medium
  - type: table
    name: Books
    filters:
      and:
        - file.inFolder("Academics/Sources/Books")
    order:
      - file.name
      - Author(s)
      - tags
    sort:
      - property: tags
        direction: DESC
      - property: URL
        direction: DESC
    columnSize:
      file.name: 200
      note.Author(s): 200
      note.Topic(s): 200
      note.Year: 200
      note.URL: 200
    rowHeight: medium
  - type: table
    name: Authors
    filters:
      and:
        - file.inFolder("Academics/Sources/Authors")
  - type: table
    name: Papers
    filters:
      and:
        - file.inFolder("Academics/Sources/Papers")
    rowHeight: medium
