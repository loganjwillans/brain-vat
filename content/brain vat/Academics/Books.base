properties:
  file.name:
    displayName: Title
  note.Topics:
    displayName: Topic(s)
  note.Author:
    displayName: Author(s)
views:
  - type: cards
    name: Card View
    filters:
      and:
        - file.inFolder("Academics/Sources/Books")
    order:
      - file.name
      - Author(s)
      - Year
      - Has Notes
    image: note.Image
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "Academics/Sources/Books"
    order:
      - file.name
      - Author
      - Year
      - Topics
    sort:
      - property: Year
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 439
      note.Author: 461
      note.Topics: 403
